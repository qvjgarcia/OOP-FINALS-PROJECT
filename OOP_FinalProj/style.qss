/* ---------- Whole Window ---------- */
QWidget {
    background-color: #f1f5f9;
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 14px;
    color: #1e293b;
}

/* ---------- Labels ---------- */
#title { 
    font-size: 24px; 
    font-weight: bold; 
    color: #12b525; 
}

#subtitle { 
    font-size: 12px; 
    color: #fcfcfd; 
}

#capacity_label { 
    font-size: 18px; 
    font-weight: bold; 
    color: #12b525; 
}

#status { 
    font-weight: bold; 
}

/* ---------- Text Boxes ---------- */
QLineEdit {
    background-color: white;
    border: 2px solid #cbd5e1;
    border-radius: 8px;
    padding: 8px;
}

QLineEdit:hover { 
    border-color: #93c5fd; 
}

QLineEdit:focus { 
    border-color: #2563eb; 
}

/* ---------- Buttons ---------- */
QPushButton {
    border: none;
    border-radius: 8px;
    padding: 10px;
    font-weight: bold;
    background-color: #e2e8f0;
}

#queue_btn { 
    background-color: #0b6f30; 
    color: #ffffff; 
}

#queue_btn:hover { 
    background-color: #3ea950; 
}

#queue_btn:pressed { 
    background-color: #0e5b0d; 
}

#start_btn_1 { 
    background-color: #0b6f30; 
    color: #ffffff; 
}

#start_btn_1:hover { 
    background-color: #3ea950; 
}

#start_btn_1:pressed { 
    background-color: #0e5b0d; 
}

#finish_btn_1 { 
    background-color: #0b6f30; 
    color: #ffffff; 
}

#finish_btn_1:hover { 
    background-color: #3ea950; 
}

#finish_btn_1:pressed { 
    background-color: #0e5b0d; 
}

#start_btn_2 { 
    background-color: #0b6f30; 
    color: #ffffff; 
}

#start_btn_2:hover { 
    background-color: #3ea950; 
}

#start_btn_2:pressed { 
    background-color: #0e5b0d; 
}

#finish_btn_2 { 
    background-color: #0b6f30; 
    color: #ffffff; 
}

#finish_btn_2:hover { 
    background-color: #3ea950; 
}

#finish_btn_2:pressed { 
    background-color: #0e5b0d; 
}

#start_btn_3 { 
    background-color: #0b6f30; 
    color: #ffffff; 
}

#start_btn_3:hover { 
    background-color: #3ea950; 
}

#start_btn_3:pressed { 
    background-color: #0e5b0d; 
}

#finish_btn_3 { 
    background-color: #0b6f30; 
    color: #ffffff; 
}

#finish_btn_3:hover { 
    background-color: #3ea950; 
}

#finish_btn_3:pressed { 
    background-color: #0e5b0d; 
}

/* ---------- Error and Success States ---------- */
QLineEdit[error="true"] {
    border-color: #dc2626;
    background-color: #fef2f2;
}

#status[state="error"] { 
    color: #dc2626; 
}

#status[state="success"] { 
    color: #16a34a; 
}

/* ---------- Instructions ---------- */
#instructions_title {
    font-size: 26px;
    font-weight: bold;
    color: #000000;
}

#instructions_info {
    font-size: 14px;
    background: transparent;
}

/* ---------- Settings ---------- */
#settings_title {
    font-size: 26px;
    color: #555555;
    margin-bottom: 10px;
}

#settings_subhead {
    font-size: 14px;
    color: #555555;
    margin-bottom: 10px;
}

QCheckBox.settingsCheckbox {
    font-size: 14px;
    padding: 5px;
}

/* ---------- Top Bar Frame ---------- */
QLabel {
    background-color: transparent;
}

#top_bar {
    background-color: #4e555f;
}
